Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"ModMat", "[", "mat_", "]"}], ":=", 
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"mati", "=", "mat"}], ",", "i", ",", "j", ",", "i2", ",", 
        "j2", ",", "ii", ",", "jj", ",", 
        RowBox[{"sz", "=", 
         RowBox[{"Length", "[", "mat", "]"}]}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"i", "=", "1"}], ",", 
         RowBox[{"i", "<=", "sz"}], ",", 
         RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"j", "=", "1"}], ",", 
            RowBox[{"j", "<=", "sz"}], ",", 
            RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Abs", "[", 
                 RowBox[{"mati", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", ",", "j"}], "]"}], "]"}], "]"}], ">", 
                RowBox[{"10", "^", "9"}]}], ",", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"ii", "=", "i"}], ";", "\[IndentingNewLine]", 
                RowBox[{"jj", "=", "j"}], ";", "\[IndentingNewLine]", 
                "\[IndentingNewLine]", 
                RowBox[{"For", "[", 
                 RowBox[{
                  RowBox[{"i2", "=", "1"}], ",", 
                  RowBox[{"i2", "<=", "sz"}], ",", 
                  RowBox[{"i2", "++"}], ",", "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{"For", "[", 
                    RowBox[{
                    RowBox[{"j2", "=", "1"}], ",", 
                    RowBox[{"j2", "<=", "sz"}], ",", 
                    RowBox[{"j2", "++"}], ",", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"mati", "[", 
                    RowBox[{"[", 
                    RowBox[{"ii", ",", "j2"}], "]"}], "]"}], "=", "0."}], ";",
                     "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"mati", "[", 
                    RowBox[{"[", 
                    RowBox[{"i2", ",", "jj"}], "]"}], "]"}], "=", "0."}], 
                    ";"}]}], "\[IndentingNewLine]", 
                    RowBox[{"(*", 
                    RowBox[{
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"i2", "==", "j2"}], ",", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"mati", "[", 
                    RowBox[{"[", 
                    RowBox[{"i2", ",", "j2"}], "]"}], "]"}], "=", "1."}], 
                    ";"}]}], "]"}], ";"}], "*)"}], "\[IndentingNewLine]", 
                    "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"mati", "[", 
