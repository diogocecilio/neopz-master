 RowBox[{"DelaunayMesh", "[", "pts", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ExportGiDMesh", "[", 
   RowBox[{"m_MeshRegion", ",", "filename_String"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"coords", ",", "cells", ",", "conn", ",", "lines"}], "}"}], ",", 
    
    RowBox[{"(*", 
     RowBox[{"n\[OAcute]", ":", "coordenadas"}], "*)"}], 
    RowBox[{
     RowBox[{"coords", "=", 
      RowBox[{"MeshCoordinates", "[", "m", "]"}]}], ";", 
     RowBox[{"(*", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x1", ",", "y1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"x2", ",", "y2"}], "}"}], ",", "..."}], "}"}], "*)"}], 
     RowBox[{"(*", 
      RowBox[{"elementos", " ", "2", 
       RowBox[{"D", ":", 
        RowBox[{"tri\[AHat]ngulos", " ", "com", " ", "conectividade"}]}]}], 
      "*)"}], 
     RowBox[{"cells", "=", 
      RowBox[{"MeshCells", "[", 
       RowBox[{"m", ",", "2"}], "]"}]}], ";", 
     RowBox[{"(*", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Triangle", "[", 
           RowBox[{"{", 
            RowBox[{"i1", ",", "i2", ",", "i3"}], "}"}], "]"}], ",", "tag"}], 
         "}"}], ",", "..."}], "}"}], "*)"}], 
     RowBox[{"conn", "=", 
      RowBox[{"First", "/@", "cells"}]}], ";", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"tira", " ", "os", " ", "tags"}], ",", 
       RowBox[{"fica", " ", "s\[OAcute]", " ", 
        RowBox[{"Triangle", "[", "...", "]"}]}]}], "*)"}], 
     RowBox[{"conn", "=", 
      RowBox[{"conn", "/.", " ", 
       RowBox[{
        RowBox[{"Triangle", "[", "idx_List", "]"}], ":>", "idx"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"monta", " ", "as", " ", "linhas", " ", "do", " ", 
       RowBox[{"arquivo", ".", "msh"}], " ", 
       RowBox[{"(", 
        RowBox[{"formato", " ", "GiD"}], ")"}]}], "*)"}], 
     RowBox[{"lines", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<MESH dimension 3 ElemType Triangle Nnode 3\>\"", 
          ",", "\"\<Coordinates\>\""}], "}"}], ",", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"StringRiffle", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"i", ",", 
              RowBox[{"coords", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", 
              RowBox[{"coords", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "2"}], "]"}], "]"}], ",", "0.0"}], "}"}], 
            ",", "\"\< \>\""}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Length", "[", "coords", "]"}]}], "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"\"\<End Coordinates\>\"", ",", "\"\<\>\"", 
          ",", "\"\<Elements\>\""}], "}"}], ",", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"StringRiffle", "[", 
           RowBox[{
            RowBox[{"Prepend", "[", 
             RowBox[{
              RowBox[{"conn", "[", 
               RowBox[{"[", "i", "]"}], "]"}], ",", "i"}], "]"}], ",", 
