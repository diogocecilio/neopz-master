             RowBox[{"elemID", " ", "n1", " ", "n2", " ", "n3"}], 
             "*)"}], "\"\< \>\""}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Length", "[", "conn", "]"}]}], "}"}]}], "]"}], ",", 
        RowBox[{"{", "\"\<End Elements\>\"", "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Export", "[", 
      RowBox[{"filename", ",", 
       RowBox[{"StringRiffle", "[", 
        RowBox[{"lines", ",", "\"\<\\n\>\""}], "]"}], ",", "\"\<String\>\""}],
       "]"}]}]}], "]"}]}], "\n", 
