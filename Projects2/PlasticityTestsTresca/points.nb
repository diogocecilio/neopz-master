Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"nR", "=", "30"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"rmin", "=", "0.01"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"rmax", "=", "20"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"radii", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"rmin", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"rmax", "/", "rmin"}], ")"}], "^", 
       RowBox[{"(", 
        RowBox[{"i", "/", 
         RowBox[{"(", 
          RowBox[{"nR", "-", "1"}], ")"}]}], ")"}]}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "0", ",", 
       RowBox[{"nR", "-", "1"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"points", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"0.5", "+", 
          RowBox[{"r", " ", 
           RowBox[{"Cos", "[", "tt", "]"}]}]}], ",", 
         RowBox[{"5", "+", 
          RowBox[{"r", " ", 
           RowBox[{"Sin", "[", "tt", "]"}]}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"tt", ",", "Pi", ",", 
         RowBox[{"2", " ", "Pi"}], ",", 
         RowBox[{"Pi", "/", "12."}]}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"r", ",", "radii"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"pointsFlat", "=", 
    RowBox[{"Select", "[", 
     RowBox[{
      RowBox[{"Flatten", "[", 
       RowBox[{"points", ",", "1"}], "]"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{
