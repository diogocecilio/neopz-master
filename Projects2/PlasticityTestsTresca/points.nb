Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"nR", "=", "10"}], ";"}], "                 ", 
  RowBox[{"(*", 
   RowBox[{"n\[UAcute]mero", " ", "de", " ", "an\[EAcute]is"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"rmin", "=", 
   RowBox[{
    RowBox[{"Exp", "[", "0.1", "]"}], "-", "1."}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"rmax", "=", 
    RowBox[{
     RowBox[{"Exp", "[", "2", "]"}], "-", "1."}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"radii", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"rmin", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"rmax", "/", "rmin"}], ")"}], "^", 
       RowBox[{"(", 
        RowBox[{"i", "/", 
         RowBox[{"(", 
          RowBox[{"nR", "-", "1"}], ")"}]}], ")"}]}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "0", ",", 
       RowBox[{"nR", "-", "1"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"points", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"0.5", "+", 
          RowBox[{"r", " ", 
           RowBox[{"Cos", "[", "tt", "]"}]}]}], ",", 
         RowBox[{"5", "+", 
          RowBox[{"r", " ", 
           RowBox[{"Sin", "[", "tt", "]"}]}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"tt", ",", "Pi", ",", 
         RowBox[{"2", " ", "Pi"}], ",", 
         RowBox[{"Pi", "/", "12."}]}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"r", ",", "radii"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pointsFlat", "=", 
   RowBox[{"Select", "[", 
    RowBox[{
     RowBox[{"Flatten", "[", 
      RowBox[{"points", ",", "1"}], "]"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"0", "<=", 
        RowBox[{"#", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "<=", "5"}], "&&", 
       RowBox[{"0", "<=", 
        RowBox[{"#", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "<=", "5"}]}], "&"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"AppendTo", "[", 
   RowBox[{"pointsFlat", ",", 
    RowBox[{"{", 
     RowBox[{"0", ",", "0"}], "}"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"AppendTo", "[", 
   RowBox[{"pointsFlat", ",", 
    RowBox[{"{", 
     RowBox[{"5", ",", "0"}], "}"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"AppendTo", "[", 
   RowBox[{"pointsFlat", ",", 
    RowBox[{"{", 
     RowBox[{"5", ",", "5"}], "}"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"AppendTo", "[", 
   RowBox[{"pointsFlat", ",", 
    RowBox[{"{", 
     RowBox[{"0", ",", "5"}], "}"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ListPlot", "[", 
   RowBox[{"pointsFlat", ",", 
    RowBox[{"AspectRatio", "->", "Automatic"}], ",", 
    RowBox[{"PlotRange", "->", "All"}]}], "]"}], "\[IndentingNewLine]", 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Export", "[", 
   RowBox[{"\"\<points.dat\>\"", ",", "pointsFlat"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"<<", "NDSolve`FEM`"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"coords", "=", "pointsFlat"}], ";"}], "  ", 
  RowBox[{"(*", 
   RowBox[{
   "isto", " ", "\[EAcute]", " ", "o", " ", "que", " ", "voc\[EHat]", " ", 
    "deve", " ", "usar"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"nRad", "=", "nR"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"nAng", "=", "12"}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"numera\[CCedilla]\[ATilde]o", " ", "estruturada"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"id", "[", 
     RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"j", "-", "1"}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"nRad", "+", "1"}], ")"}]}], "+", "i"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", "\n", 
   RowBox[{"(*", 
    RowBox[{"conectividade", " ", "dos", " ", "quads"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"quads", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"id", "[", 
            RowBox[{"i", ",", "j"}], "]"}], ",", 
           RowBox[{"id", "[", 
            RowBox[{
             RowBox[{"i", "+", "1"}], ",", "j"}], "]"}], ",", 
           RowBox[{"id", "[", 
            RowBox[{
             RowBox[{"i", "+", "1"}], ",", 
             RowBox[{"j", "+", "1"}]}], "]"}], ",", 
           RowBox[{"id", "[", 
