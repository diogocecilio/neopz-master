Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"nR", "=", "30"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"rmin", "=", "0.01"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"rmax", "=", "20"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"radii", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"rmin", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"rmax", "/", "rmin"}], ")"}], "^", 
       RowBox[{"(", 
        RowBox[{"i", "/", 
         RowBox[{"(", 
