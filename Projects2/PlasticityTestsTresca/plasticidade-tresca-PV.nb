Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"pts", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"pts1", ",", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ">", "0"}], "&&", 
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}], ">", "0"}]}], "&"}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"data", "=", 
     RowBox[{"Transpose", "@", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Log", "[", 
         RowBox[{"pts", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}], ",", 
        RowBox[{"Log", "[", 
         RowBox[{"pts", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], "}"}]}]}], ";"}],
    "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fit", "=", 
     RowBox[{"LinearModelFit", "[", 
      RowBox[{"data", ",", "x", ",", "x"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"b1", "=", 
     RowBox[{
      RowBox[{"fit", "[", "\"\<BestFitParameters\>\"", "]"}], "[", 
      RowBox[{"[", "2", "]"}], "]"}]}], ";"}], "      ", 
   RowBox[{"(*", "slope", "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"xmin", ",", "xmax"}], "}"}], "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Min", "[", 
        RowBox[{"data", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}], ",", 
       RowBox[{"Max", "[", 
        RowBox[{"data", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"ymin", ",", "ymax"}], "}"}], "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Min", "[", 
        RowBox[{"data", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}], ",", 
       RowBox[{"Max", "[", 
        RowBox[{"data", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], "}"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "tri\[AHat]ngulo"}]}], " ", "colado", " ", "na", " ", 
      RowBox[{"reta", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"base", "=", "1.0"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"x0", "=", 
     RowBox[{"Min", "[", 
      RowBox[{
       RowBox[{"xmin", "+", 
        RowBox[{"0.08", " ", 
         RowBox[{"(", 
          RowBox[{"xmax", "-", "xmin"}], ")"}]}]}], ",", 
       RowBox[{"xmax", "-", "base", "-", 
        RowBox[{"0.02", " ", 
         RowBox[{"(", 
          RowBox[{"xmax", "-", "xmin"}], ")"}]}]}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"p0", "=", 
     RowBox[{"{", 
      RowBox[{"x0", ",", 
       RowBox[{"fit", "[", "x0", "]"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"p1", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"x0", "+", "base"}], ",", 
       RowBox[{"fit", "[", 
        RowBox[{"x0", "+", "base"}], "]"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"p2", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"x0", "+", "base"}], ",", 
       RowBox[{"fit", "[", "x0", "]"}]}], "}"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"theta", "=", 
     RowBox[{"ArcTan", "[", "b1", "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tri", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Directive", "[", 
        RowBox[{"Opacity", "[", ".25", "]"}], "]"}], ",", 
       RowBox[{"EdgeForm", "[", 
        RowBox[{"{", 
         RowBox[{"Blue", ",", "Thick"}], "}"}], "]"}], ",", 
       RowBox[{"Polygon", "[", 
        RowBox[{"{", 
         RowBox[{"p0", ",", "p1", ",", "p2"}], "}"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"Dashed", ",", "Black", ",", "Thick", ",", 
         RowBox[{"Line", "[", 
          RowBox[{"{", 
           RowBox[{"p0", ",", "p1"}], "}"}], "]"}], ",", 
         RowBox[{"Line", "[", 
          RowBox[{"{", 
           RowBox[{"p1", ",", "p2"}], "}"}], "]"}], ",", 
         RowBox[{"Line", "[", 
          RowBox[{"{", 
           RowBox[{"p2", ",", "p0"}], "}"}], "]"}]}], "}"}], ",", 
       RowBox[{"(*", 
