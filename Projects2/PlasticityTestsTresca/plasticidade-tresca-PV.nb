Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{"x_", ",", "xp_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"ProjectStress", "[", 
       RowBox[{"x", ",", "xp", ",", "0", ",", "subst"}], "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"df", "[", 
      RowBox[{"x_", ",", "xp_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"ProjectStress", "[", 
       RowBox[{"x", ",", "xp", ",", "0", ",", "subst"}], "]"}], "[", 
      RowBox[{"[", "2", "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"type", "[", 
      RowBox[{"x_", ",", "xp_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"ProjectStress", "[", 
       RowBox[{"x", ",", "xp", ",", "0", ",", "subst"}], "]"}], "[", 
      RowBox[{"[", "4", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"err", "[", 
      RowBox[{
       RowBox[{"\[Alpha]1_", "?", "NumericQ"}], ",", 
       RowBox[{"\[Alpha]2_", "?", "NumericQ"}], ",", "x00_", ",", "xpp_", ",",
        "typecheck_"}], "]"}], ":=", 
     RowBox[{"Block", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"xp", "=", "xpp"}], ",", 
         RowBox[{"x0", "=", "x00"}], ",", "dx", ",", "f0", ",", "g0", ",", 
         "gdx", ",", "error1", ",", "error2", ",", "p", ",", "state0", ",", 
         RowBox[{"scale", "=", "1."}], ",", 
         RowBox[{"tries", "=", "0"}], ",", 
         RowBox[{"maxtries", "=", "1"}]}], "}"}], ",", 
       RowBox[{"(*", 
        RowBox[{"dire\[CCedilla]\[ATilde]o", " ", "pequena"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"dx", "=", 
         RowBox[{"RandomReal", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", "6"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Norm", "[", "dx", "]"}], "==", "0."}], ",", 
          RowBox[{"dx", "=", 
           RowBox[{"ConstantArray", "[", 
            RowBox[{"1.", ",", "6"}], "]"}]}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"dx", "=", 
         RowBox[{"1.*^-3", " ", 
          RowBox[{"Normalize", "[", "dx", "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"estado", " ", "base", " ", 
          RowBox[{"(", 
           RowBox[{"uma", " ", "chamada", " ", "s\[OAcute]"}], ")"}]}], 
         "*)"}], "\[IndentingNewLine]", 
        RowBox[{"state0", "=", 
         RowBox[{"ProjectStress", "[", 
          RowBox[{"x0", ",", "xp", ",", "0", ",", "subst"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"f0", "=", 
         RowBox[{"state0", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"g0", "=", 
         RowBox[{"state0", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"gdx", "=", 
         RowBox[{"g0", ".", "dx"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "garantir", " ", "que", " ", "o", " ", "ponto", " ", "perturbado", " ",
           "mant\[EAcute]m", " ", "o", " ", "mesmo", " ", "tipo"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"While", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
